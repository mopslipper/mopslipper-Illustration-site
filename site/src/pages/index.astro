---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import { siteConfig, commission, works, heroImages, resolveRootImage, url } from '../lib/data';

// static/img/hero/ の画像（ファイル名順）を優先。空なら config.json の hero_image 1枚にフォールバック
const fallbackHero = resolveRootImage(siteConfig.hero_image);
const stripImages = heroImages.length > 0 ? heroImages : fallbackHero ? [fallbackHero] : [];
const recentWorks = works.filter((w) => !w.nsfw).slice(0, 6);
const social = siteConfig.social_links;
---

<Layout activeNav="home">
  <section class="hero">
    {
      stripImages.length > 0 && (
        <div class="hero-strip" data-count={stripImages.length}>
          {stripImages.map((img) => (
            <Image src={img} alt="" class="hero-strip-img" widths={[480, 800]} format="webp" />
          ))}
        </div>
      )
    }
    <div class="hero-content">
      <h1>{siteConfig.hero_text}</h1>
      <p>{siteConfig.hero_subtext}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={url('/gallery.html')}>Gallery</a>
        <a class="btn btn-outline" href={url('/contact.html')}>イラストリクエスト</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="commission-status">
      {
        commission.status.open ? (
          <span class="badge">✓ {commission.status.message}</span>
        ) : (
          <span class="badge closed">● 締切中</span>
        )
      }
      <a href={url('/commission.html')}>詳細を見る →</a>
    </div>
  </section>

  <section class="section container">
    <h2 class="section-title">Recent Works</h2>
    <div class="works-grid">
      {recentWorks.map((work) => <WorkCard work={work} />)}
    </div>
    <p class="text-center" style="margin-top:1.5rem;">
      <a class="btn btn-outline" href={url('/gallery.html')}>すべて見る →</a>
    </p>
  </section>

  <section class="section container">
    <h2 class="section-title">Links</h2>
    <div class="links-grid">
      {
        social.twitter && (
          <a class="link-card" href={social.twitter} target="_blank" rel="noopener">
            <strong>X (Twitter)</strong>
            <span class="muted">最新作品をチェック {social.twitter_handle}</span>
          </a>
        )
      }
      {
        social.pixiv && (
          <a class="link-card" href={social.pixiv} target="_blank" rel="noopener">
            <strong>Pixiv</strong>
            <span class="muted">作品まとめはこちら</span>
          </a>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
  }

  .hero-strip {
    position: absolute;
    inset: 0;
    display: flex;
  }

  .hero :global(.hero-strip-img) {
    flex: 1 1 0;
    min-width: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* モバイルでは帯が細切れになるため先頭2枚のみ表示 */
  @media (max-width: 600px) {
    .hero :global(.hero-strip-img:nth-child(n + 3)) {
      display: none;
    }
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(14, 13, 18, 0.35),
      rgba(14, 13, 18, 0.92) 95%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 3rem 1rem;
  }

  .hero-content h1 {
    font-size: clamp(1.6rem, 4.5vw, 2.6rem);
    color: #fff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
    margin-bottom: 0.5rem;
  }

  .hero-content p {
    font-weight: 500;
    color: var(--text);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
    margin-bottom: 1.4rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .commission-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--bg-card);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 1rem;
    font-weight: 700;
  }

  .badge.closed {
    background: var(--text-muted);
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .link-card {
    background: var(--bg-card);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .link-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    text-decoration: none;
  }
</style>
