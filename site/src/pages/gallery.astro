---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import RandomWork from '../components/RandomWork.astro';
import { works, tagCounts, url } from '../lib/data';
import { CATEGORIES } from '../lib/schema';

// 作品があるカテゴリだけを、定義順に出す
const categoryCounts = CATEGORIES.map((category) => ({
  category,
  count: works.filter((w) => w.category === category).length,
})).filter(({ count }) => count > 0);

const TOP_TAGS = 20;
const popularTags = tagCounts.slice(0, TOP_TAGS);
const otherTags = tagCounts.slice(TOP_TAGS);
const r15Count = works.filter((w) => w.sensitive).length;
---

<Layout title="Gallery" activeNav="gallery">
  <section class="section container">
    <h1 class="section-title">Gallery</h1>

    <div class="gallery-layout">
      <aside class="gallery-sidebar">
        <details class="filter-drawer" id="filter-drawer" open>
          <summary>絞り込み・検索</summary>

          <div class="panel">
            <h2><label for="search-input">検索</label></h2>
            <input type="search" id="search-input" placeholder="タイトル・タグ・説明文" autocomplete="off" />
          </div>

          <div class="panel">
            <h2>カテゴリ</h2>
            <div class="category-list">
              <button class="cat-btn active" type="button" data-category-btn="" aria-pressed="true">
                <span>すべて</span><span class="count">{works.length}</span>
              </button>
              {
                categoryCounts.map(({ category, count }) => (
                  <button class="cat-btn" type="button" data-category-btn={category} aria-pressed="false">
                    <span>{category}</span>
                    <span class="count">{count}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <div class="panel">
            <h2>タグ</h2>
            <div class="tag-cloud">
              {
                popularTags.map(([tag]) => (
                  <button class="tag" type="button" data-tag-btn={tag} aria-pressed="false">
                    {tag}
                  </button>
                ))
              }
            </div>
            {
              otherTags.length > 0 && (
                <details class="more-tags">
                  <summary>ほかのタグ（{otherTags.length}）</summary>
                  <div class="tag-cloud">
                    {otherTags.map(([tag]) => (
                      <button class="tag" type="button" data-tag-btn={tag} aria-pressed="false">
                        {tag}
                      </button>
                    ))}
                  </div>
                </details>
              )
            }
          </div>

          {
            r15Count > 0 && (
              <div class="panel">
                <label class="check">
                  <input type="checkbox" id="show-r15" />
                  <span>
                    R-15 作品のみ <span class="muted">（{r15Count}）</span>
                  </span>
                </label>
              </div>
            )
          }
        </details>

        <div class="panel panel-request">
          <p>探している子がいなければ、リクエストで作ります。</p>
          <a class="btn btn-outline btn-sm" href={url('/request.html')}>リクエストする</a>
        </div>
      </aside>

      <div class="gallery-main" id="gallery-main">
        <div class="result-bar">
          <p>
            <strong id="active-filters">すべての作品</strong>
            <span class="muted" id="result-count">{works.length} 件</span>
          </p>
          <div class="row">
            <button class="btn btn-ghost btn-sm" type="button" id="clear-filters" hidden>絞り込みを解除</button>
            <RandomWork />
          </div>
        </div>

        <div class="works-grid" id="works-grid">
          {works.map((work) => <WorkCard work={work} />)}
        </div>

        <div class="no-results" id="no-results" hidden>
          <p>該当する作品が見つかりませんでした。</p>
          <p class="muted">探している子がいなければ、リクエストしてみませんか？</p>
          <a class="btn btn-primary" id="no-results-request" href={url('/request.html')} data-base={url('/request.html')}>
            これをリクエストする
          </a>
        </div>

        <nav class="pagination" data-pagination aria-label="ページ送り"></nav>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>

<style>
  .gallery-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    margin-top: 1.4rem;
  }

  .gallery-sidebar {
    position: sticky;
    top: 4.5rem;
    max-height: calc(100vh - 5.5rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .filter-drawer > summary {
    display: none;
  }

  @media (max-width: 800px) {
    .gallery-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .gallery-sidebar {
      position: static;
      max-height: none;
      overflow: visible;
    }

    .filter-drawer > summary {
      display: block;
      cursor: pointer;
      font-weight: 700;
      padding: 0.7rem 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-card);
      margin-bottom: 0.7rem;
    }

    .panel-request {
      display: none;
    }
  }

  .panel {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem;
    margin-bottom: 0.7rem;
  }

  .panel h2 {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 0.55rem;
  }

  .category-list {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .cat-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--text);
    cursor: pointer;
    transition: background 0.15s;
  }

  .cat-btn .count {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .cat-btn:hover {
    background: var(--primary-pale);
  }

  .cat-btn.active {
    background: var(--primary-pale);
    color: var(--primary-deep);
    font-weight: 700;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .more-tags {
    margin-top: 0.6rem;
  }

  .more-tags summary {
    cursor: pointer;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .panel-request {
    font-size: 0.88rem;
    border-style: dashed;
  }

  .panel-request p {
    margin-bottom: 0.6rem;
  }

  .result-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }

  .result-bar .muted {
    margin-left: 0.5rem;
    font-size: 0.9rem;
  }

  .no-results {
    text-align: center;
    padding: 2.5rem 1rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
  }

  .no-results .btn {
    margin-top: 1rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1.6rem;
    flex-wrap: wrap;
  }

  .pagination :global(button) {
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    background: var(--bg-card);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--text);
    cursor: pointer;
  }

  .pagination :global(button.active) {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--ink-on-primary);
  }

  .pagination :global(button:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>
