---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../lib/data';
---

<Layout title="Request / Contact" activeNav="contact">
  <section class="section container narrow">
    <h1 class="section-title">Request / Contact</h1>

    <div class="notice">
      <p>「こんなイラスト見てみたい！」というリクエストがあれば気軽にどうぞ！</p>
      <p>無償で作って投稿します。お名前やメールアドレスは書かなくてもOKです！</p>
      <p class="muted">※ 返信は気が付いた時にします。採用を保証するものではありませんのでご了承ください。</p>
      <p class="muted">
        ※ R-18（成人向け）内容は無償リクエストでは受け付けておりません。ちょっとセクシーくらいなら大丈夫です！
      </p>
    </div>

    <form id="contact-form" action={siteConfig.contact_form_action} method="POST">
      <div class="form-group">
        <label for="name">お名前 <span class="muted">(任意)</span></label>
        <input type="text" id="name" name="name" autocomplete="name" />
      </div>

      <div class="form-group">
        <label for="email">メールアドレス <span class="muted">(任意)</span></label>
        <input type="email" id="email" name="email" autocomplete="email" />
      </div>

      <div class="form-group">
        <label for="subject">カテゴリ <span class="required">必須</span></label>
        <select id="subject" name="subject" required>
          <option value="イラストリクエスト">イラストリクエスト</option>
          <option value="質問・感想">質問・感想</option>
          <option value="その他">その他</option>
        </select>
      </div>

      <div class="form-group">
        <label for="message">リクエスト内容 <span class="required">必須</span></label>
        <textarea id="message" name="message" rows="8" required></textarea>
      </div>

      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="request_source" id="request_source" />
      <input type="hidden" name="reference_work_slug" id="reference_work_slug" />
      <input type="hidden" name="reference_work_title" id="reference_work_title" />
      <input type="hidden" name="reference_request_tags" id="reference_request_tags" />
      <input type="hidden" name="reference_work_url" id="reference_work_url" />

      <div class="reference-box" id="reference-box" hidden>
        <p>参照作品: <strong id="reference-label"></strong></p>
      </div>

      <p class="text-center">
        <button type="submit" class="btn btn-primary" id="submit-btn">送信する</button>
      </p>
    </form>

    <div class="notice text-center" id="form-result" hidden></div>
  </section>
</Layout>

<script>
  // 作品詳細からの参照プリフィル（?from=work&slug=...&title=...&request_tags=...）
  const params = new URLSearchParams(location.search);
  if (params.get('from') === 'work') {
    const title = params.get('title') ?? '';
    const tags = params.get('request_tags') ?? '';
    (document.getElementById('request_source') as HTMLInputElement).value = 'work_detail';
    (document.getElementById('reference_work_slug') as HTMLInputElement).value = params.get('slug') ?? '';
    (document.getElementById('reference_work_title') as HTMLInputElement).value = title;
    (document.getElementById('reference_request_tags') as HTMLInputElement).value = tags;
    (document.getElementById('reference_work_url') as HTMLInputElement).value = document.referrer;
    const box = document.getElementById('reference-box')!;
    box.hidden = false;
    document.getElementById('reference-label')!.textContent = title;
    const message = document.getElementById('message') as HTMLTextAreaElement;
    message.value = `「${title}」の雰囲気をベースにリクエストします。\n参考タグ: ${tags}\n\n【リクエスト内容】\n`;
  }

  // Formspree へ fetch 送信
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const result = document.getElementById('form-result')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = '送信中…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      result.hidden = false;
      if (res.ok) {
        result.innerHTML =
          '<strong>✓ 送信完了</strong><br>リクエストありがとうございます！採用できた場合はX（Twitter）などで投稿します。';
        form.reset();
        form.hidden = true;
      } else {
        result.innerHTML = '<strong>✕ 送信エラー</strong><br>送信に失敗しました。時間をおいて再度お試しください。';
      }
    } catch {
      result.hidden = false;
      result.innerHTML = '<strong>✕ 送信エラー</strong><br>送信に失敗しました。時間をおいて再度お試しください。';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '送信する';
    }
  });
</script>

<style>
  .narrow {
    max-width: 640px;
  }

  .reference-box {
    background: var(--bg-accent);
    border-radius: var(--radius);
    padding: 0.8rem 1rem;
    margin-bottom: 1rem;
    font-size: 0.92rem;
  }
</style>
