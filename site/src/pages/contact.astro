---
import Layout from '../layouts/Layout.astro';
import { siteConfig, url } from '../lib/data';
---

<Layout title="Contact" activeNav="contact">
  <section class="section container narrow">
    <h1 class="section-title">Contact</h1>
    <p class="section-lead">質問・感想・そのほかのご連絡はこちらから。</p>

    <div class="notice">
      <p>
        イラストのリクエストは
        <a href={url('/request.html')}><strong>リクエストページ</strong></a> からどうぞ（自由に書いても、えらぶだけでも送れます）。
      </p>
      <p class="muted">※ お名前やメールアドレスは書かなくてもOKです。返信は気が付いた時にします。</p>
    </div>

    <form id="contact-form" action={siteConfig.contact_form_action} method="POST">
      <div class="form-group">
        <label for="name">お名前 <span class="optional">任意</span></label>
        <input type="text" id="name" name="name" autocomplete="name" />
      </div>

      <div class="form-group">
        <label for="email">メールアドレス <span class="optional">任意</span></label>
        <input type="email" id="email" name="email" autocomplete="email" />
      </div>

      <div class="form-group">
        <label for="subject">カテゴリ</label>
        <select id="subject" name="subject" required>
          <option value="質問・感想">質問・感想</option>
          <option value="リクエスト掲載の取り下げ">リクエスト掲載の取り下げ</option>
          <option value="その他">その他</option>
        </select>
      </div>

      <div class="form-group">
        <label for="message">内容 <span class="required">必須</span></label>
        <textarea id="message" name="message" rows="8" required></textarea>
      </div>

      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <p class="text-center">
        <button type="submit" class="btn btn-primary" id="submit-btn">送信する</button>
      </p>
    </form>

    <div class="notice text-center" id="form-result" role="status" hidden></div>
  </section>
</Layout>

<script>
  // 旧サイトの「この作品をベースに依頼する」リンク（contact.html?from=work&slug=...）は
  // リクエストページへ引き継ぐ
  const params = new URLSearchParams(location.search);
  if (params.get('from') === 'work' && params.get('slug')) {
    const next = new URLSearchParams({ from: 'work', slug: params.get('slug')! });
    location.replace(`${location.pathname.replace(/contact(\.html)?$/, 'request.html')}?${next}`);
  }

  // Formspree へ fetch 送信
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const result = document.getElementById('form-result')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  const showResult = (title: string, body: string) => {
    const strong = document.createElement('strong');
    strong.textContent = title;
    result.replaceChildren(strong, document.createElement('br'), body);
    result.hidden = false;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = '送信中…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      showResult('✓ 送信完了', 'ありがとうございます！内容を確認します。');
      form.reset();
      form.hidden = true;
    } catch {
      showResult('✕ 送信エラー', '送信に失敗しました。時間をおいて再度お試しください。');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '送信する';
    }
  });
</script>
