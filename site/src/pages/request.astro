---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import MyRequests from '../components/MyRequests.astro';
import { works, siteConfig, requestOptions, resolveWorkThumb, jsonForScript, url, THUMB_SIZE } from '../lib/data';

// 作品ページからの引き継ぎ用（slug だけを URL で受け取り、題名・サムネはここから引く）
const worksData = Object.fromEntries(
  await Promise.all(
    works.map(async (work) => {
      const thumb = resolveWorkThumb(work);
      const image = thumb
        ? await getImage({ src: thumb, width: THUMB_SIZE, height: THUMB_SIZE, format: 'webp' })
        : undefined;
      return [work.slug, { title: work.title, thumb: image?.src ?? '' }] as const;
    }),
  ),
);
---

<Layout
  title="リクエスト"
  description="見てみたいイラストを自由にリクエストできます。えらぶだけでも送れて、名前もメールもいりません。"
  activeNav="request"
>
  <section class="section container">
    <h1 class="section-title">リクエスト</h1>
    <p class="section-lead">
      「こんなイラスト見てみたい！」を自由に書いてください。<br />
      名前もメールもいりません。無償で作って投稿します。
    </p>

    <div class="done card" id="request-done" tabindex="-1" hidden>
      <p class="done-title">リクエストを受け取りました！</p>
      <p>受付番号 <strong class="receipt" id="done-receipt"></strong></p>
      <p class="muted" id="done-saved">
        この番号はこのブラウザに保存しました。作ることになったら「リクエスト対応予定」に載るので、また見に来てください。
      </p>
      <p class="muted" id="done-unsaved" hidden>
        このブラウザには番号を保存できませんでした。「リクエスト対応予定」で探せるよう、番号をメモしておいてください。
      </p>
      <div class="row done-actions">
        <a class="btn btn-primary" href={url('/requests.html')}>リクエスト対応予定を見る</a>
        <a class="btn btn-ghost" href={url('/request.html')}>もうひとつ送る</a>
        <a class="btn btn-ghost" href={url('/gallery.html')}>Gallery にもどる</a>
      </div>
    </div>

    <form id="request-form" class="request-layout" action={siteConfig.contact_form_action} method="POST">
      <div class="request-main">
        <div class="reference card" id="reference-box" hidden>
          <img id="reference-thumb" alt="" width="96" height="96" />
          <div class="reference-body">
            <p class="muted small">この子をベースに</p>
            <p class="reference-title" id="reference-title"></p>
            <div class="chips">
              {
                requestOptions.variants.map((variant) => (
                  <label class="chip-check">
                    <input type="radio" name="variant" value={variant.id} data-label={variant.label} />
                    <span class="chip">{variant.label}</span>
                  </label>
                ))
              }
            </div>
            <button class="link-btn" type="button" id="reference-remove">ベースの作品を外す</button>
          </div>
        </div>

        <div class="free">
          <label for="request-note">見てみたいイラストを、自由に書いてください</label>
          <textarea
            id="request-note"
            name="message"
            rows="7"
            maxlength="2000"
            placeholder="例: ぶかぶかのパーカーを着た白髪のネコミミちゃんが、ねむそうな顔でぬいぐるみを抱っこしているところ"></textarea>
          <p class="muted small">
            どんな子か、服、ポーズ、表情、こだわりなど、思いつくままでOK。短くても長くても大丈夫です。
          </p>
          <a class="jump small" href="#request-side">書けたら、このまま送信へ ↓</a>
        </div>

        <div class="picks">
          <div class="picks-head">
            <div>
              <h2>えらぶだけでもOK</h2>
              <p class="muted small">
                言葉にしにくいときは、気になるものをタップするだけで送れます。上の文章に足すこともできます。
              </p>
            </div>
            <div class="row">
              <button class="btn btn-ghost btn-sm" type="button" id="gacha">🎲 お題ガチャ</button>
              <button class="btn btn-ghost btn-sm" type="button" id="clear-picks">えらび直す</button>
            </div>
          </div>

          {
            requestOptions.groups.map((group) => (
              <fieldset class="pick-group" data-pick-group={group.id} data-label={group.label}>
                <legend>{group.label}</legend>
                <div class="chips">
                  {group.options.map((option) => (
                    <label class="chip-check">
                      <input type="checkbox" name={group.label} value={option} />
                      <span class="chip">{option}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))
          }
        </div>
      </div>

      <aside class="request-side card" id="request-side">
        <h2>こんなリクエストになります</h2>
        <p class="preview is-empty" id="request-preview" aria-live="polite">書いた内容・えらんだ内容がここに表示されます。</p>

        <p class="publish-note small">
          作ることにしたリクエストは、内容を
          <a href={url('/requests.html')}>リクエスト対応予定</a>
          に載せます（ニックネームを書いた場合は、ニックネームも）。
        </p>

        <div class="form-group">
          <label for="nickname">ニックネーム <span class="optional">任意</span></label>
          <input type="text" id="nickname" name="name" maxlength="30" autocomplete="nickname" />
        </div>

        <details class="reply">
          <summary>返信がほしい方へ</summary>
          <div class="form-group">
            <label for="email">メールアドレス <span class="optional">任意</span></label>
            <input type="email" id="email" name="email" autocomplete="email" />
            <p class="muted small">返信は気が付いた時にします。</p>
          </div>
        </details>

        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="subject" value="イラストリクエスト" />

        <button type="submit" class="btn btn-primary submit" id="request-submit">リクエストを送る</button>
        <p class="muted small text-center" id="request-hint" hidden>リクエストを書くか、何かえらぶと送れます。</p>
        <p class="error" id="request-error" role="alert" hidden></p>

        <ul class="rules muted small">
          <li>背景は基本的に白背景で作ります。</li>
          <li>採用を保証するものではありません。できあがったら X（Twitter）やこのサイトに投稿します。</li>
          <li>R-18（成人向け）は受け付けていません。ちょっとセクシーくらい（R-15 まで）なら大丈夫です！</li>
        </ul>
      </aside>
    </form>

    <div class="mine">
      <MyRequests />
    </div>
  </section>
</Layout>

<script is:inline type="application/json" id="request-works-data" set:html={jsonForScript(worksData)} />

<script>
  import { initRequestForm } from '../scripts/request-form';
  initRequestForm();
</script>

<style>
  .request-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 1.8rem;
    align-items: start;
  }

  .request-side {
    position: sticky;
    top: 5rem;
  }

  @media (max-width: 860px) {
    .request-layout {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .request-side {
      position: static;
    }
  }

  .reference {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1.4rem;
    border-color: var(--primary-soft);
  }

  .reference img {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .reference-body {
    min-width: 0;
  }

  .reference-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
  }

  .link-btn {
    margin-top: 0.6rem;
    background: none;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.82rem;
    text-decoration: underline;
    cursor: pointer;
  }

  .link-btn:hover {
    color: var(--primary-deep);
  }

  .free {
    margin-bottom: 1.6rem;
  }

  .free label {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
  }

  .free textarea {
    min-height: 11rem;
    padding: 1rem 1.1rem;
    border-color: var(--primary-soft);
    border-radius: var(--radius);
    background: var(--bg-card);
    font-size: 1.02rem;
  }

  .free textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(255, 105, 180, 0.15);
  }

  .free p {
    margin-top: 0.45rem;
  }

  /* 送信欄が下に回る狭い画面だけ、選択肢を飛ばして送信へ進めるリンクを出す */
  .jump {
    display: none;
    margin-top: 0.5rem;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .jump {
      display: inline-block;
    }
  }

  .picks {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    padding: 1.1rem 1.1rem 0.2rem;
  }

  .picks-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin-bottom: 1.1rem;
  }

  .picks-head > div:first-child {
    flex: 1 1 16rem;
  }

  .picks-head h2 {
    font-size: 1rem;
    color: var(--primary-deep);
  }

  .pick-group {
    border: none;
    margin-bottom: 1.1rem;
  }

  .pick-group legend {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 0.45rem;
  }

  .picks :global(.chip) {
    min-height: 2.2rem;
    font-size: 0.88rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .chip-check {
    position: relative;
    display: inline-flex;
  }

  .chip-check input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    margin: 0;
  }

  .chip-check input:checked + .chip {
    background: var(--primary-pale);
    border-color: var(--primary);
    color: var(--primary-deep);
    font-weight: 700;
  }

  .chip-check input:checked + .chip::before {
    content: '✓';
    font-size: 0.8rem;
  }

  .chip-check input:focus-visible + .chip {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .chip-check:hover .chip {
    border-color: var(--primary-soft);
  }

  .request-side h2 {
    font-size: 0.95rem;
    color: var(--primary-deep);
    margin-bottom: 0.6rem;
  }

  .preview {
    white-space: pre-line;
    background: var(--bg-accent);
    border-radius: var(--radius-sm);
    padding: 0.8rem 0.9rem;
    font-size: 0.92rem;
    min-height: 4.5rem;
    margin-bottom: 1.1rem;
  }

  .preview.is-empty {
    color: var(--text-muted);
  }

  .publish-note {
    margin-bottom: 1.1rem;
    padding: 0.55rem 0.8rem;
    border-left: 3px solid var(--primary-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--bg-accent);
  }

  .request-side .form-group label {
    font-size: 0.9rem;
  }

  .reply {
    margin-bottom: 1.1rem;
  }

  .reply summary {
    cursor: pointer;
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .reply .form-group {
    margin-bottom: 0;
  }

  .submit {
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .error {
    color: var(--danger);
    font-size: 0.88rem;
    font-weight: 700;
    margin-top: 0.4rem;
  }

  .rules {
    margin-top: 0.9rem;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .done {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    padding: 2rem 1.4rem;
    border-color: var(--primary-soft);
  }

  .done:focus {
    outline: none;
  }

  .done-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--primary-deep);
    margin-bottom: 0.6rem;
  }

  .receipt {
    display: inline-block;
    font-size: 1.6rem;
    letter-spacing: 0.1em;
    margin: 0.2rem 0 0.6rem 0.4rem;
    vertical-align: middle;
  }

  .done-actions {
    justify-content: center;
    margin-top: 1.2rem;
  }

  .mine :global(.my-requests) {
    max-width: 560px;
    margin: 2rem auto 0;
  }
</style>
