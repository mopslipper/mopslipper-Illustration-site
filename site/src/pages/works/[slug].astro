---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import WorkCard from '../../components/WorkCard.astro';
import {
  works,
  siteConfig,
  requestOptions,
  isVideo,
  resolveWorkImage,
  resolveVideoUrl,
  getRequestsForWork,
  formatDate,
  tagUrl,
  url,
} from '../../lib/data';
import { relatedWorks } from '../../lib/related';

export function getStaticPaths() {
  return works.map((work, i) => ({
    params: { slug: work.slug },
    props: {
      work,
      prevWork: works[i + 1] ?? null, // worksは新しい順: 次に古い作品
      nextWork: works[i - 1] ?? null,
    },
  }));
}

const { work, prevWork, nextWork } = Astro.props;

const video = isVideo(work.image_path);
const mainImage = video ? undefined : resolveWorkImage(work.image_path);
const videoUrl = video ? resolveVideoUrl(work.image_path) : undefined;
const additionalImages = (work.additional_images ?? [])
  .map((p) => resolveWorkImage(p))
  .filter((img) => img !== undefined);
const allImages = mainImage ? [mainImage, ...additionalImages] : additionalImages;

const links = work.external_links ?? {};
const linkEntries = Object.entries(links).filter(([, v]) => v);
const linkLabels: Record<string, string> = { twitter: 'X (Twitter)', pixiv: 'Pixiv', booth: 'BOOTH', fanbox: 'FANBOX' };

const related = relatedWorks(work, works, 6);
const origins = getRequestsForWork(work.slug);

const requestUrl = (variant?: string) =>
  `${url('/request.html')}?${new URLSearchParams({ from: 'work', slug: work.slug, ...(variant ? { variant } : {}) })}`;

// OGP: R-15 で X 非表示指定のものはプレースホルダー（旧サイト互換）
const hideOgThumb = work.sensitive && work.hide_sensitive_thumbnail_on_x;
const ogSource = hideOgThumb
  ? '/static/img/works/placeholder.svg'
  : (work.x_thumbnail ?? work.thumbnail);
const ogImg = resolveWorkImage(ogSource);
const ogImage = ogImg ? new URL(ogImg.src, Astro.site).href : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout title={work.title} description={work.description || undefined} ogImage={ogImage} activeNav="gallery">
  <section class="section container detail">
    <nav class="detail-nav" aria-label="作品の前後">
      {
        prevWork ? (
          <a href={url(`/works/${prevWork.slug}.html`)} rel="prev">← 前の作品</a>
        ) : (
          <span class="muted">← 前の作品</span>
        )
      }
      <a href={url('/gallery.html')}>Gallery</a>
      {
        nextWork ? (
          <a href={url(`/works/${nextWork.slug}.html`)} rel="next">次の作品 →</a>
        ) : (
          <span class="muted">次の作品 →</span>
        )
      }
    </nav>

    <div class="detail-grid">
      <div class="media-column">
        {
          video ? (
            <video src={videoUrl} controls loop playsinline class="main-media"></video>
          ) : (
            allImages.length > 0 && (
              <>
                <div class="main-image-wrap" id="pswp-gallery">
                  {allImages.map((img, i) => (
                    <a
                      href={img.src}
                      data-pswp-width={img.width}
                      data-pswp-height={img.height}
                      class={`main-image${i === 0 ? ' active' : ''}`}
                      data-index={i}
                    >
                      <Image
                        src={img}
                        alt={allImages.length > 1 ? `${work.title} (${i + 1}/${allImages.length})` : work.title}
                        width={900}
                        format="webp"
                        loading={i === 0 ? 'eager' : 'lazy'}
                      />
                    </a>
                  ))}
                  {allImages.length > 1 && (
                    <>
                      <button class="img-nav img-nav-prev" id="img-prev" aria-label="前の画像" type="button">‹</button>
                      <button class="img-nav img-nav-next" id="img-next" aria-label="次の画像" type="button">›</button>
                    </>
                  )}
                </div>
                {allImages.length > 1 && (
                  <div class="thumb-strip" id="thumb-strip">
                    {allImages.map((img, i) => (
                      <button
                        class={`thumb-btn${i === 0 ? ' active' : ''}`}
                        data-index={i}
                        type="button"
                        aria-label={`${i + 1}枚目を表示`}
                      >
                        <Image src={img} alt="" width={100} height={100} format="webp" />
                      </button>
                    ))}
                  </div>
                )}
              </>
            )
          )
        }
      </div>

      <div class="info-column">
        <h1>{work.title}</h1>
        <div class="meta-row">
          <time datetime={work.date} class="muted">{formatDate(work.date)}</time>
          <span class="tag">{work.category}</span>
          {work.sensitive && <span class="r15-mark">R-15</span>}
        </div>
        <div class="meta-row stats-row">
          <span class="stat" title="閲覧数">👁 <span id="view-count">–</span></span>
          <button class="like-btn" id="like-btn" data-work-id={work.id} title="いいね" type="button">
            ♥ <span id="like-count">–</span>
          </button>
        </div>

        {work.description && <p class="description">{work.description}</p>}

        <div class="meta-row">
          {work.tags.map((tag) => <a class="tag" href={tagUrl(tag)}>{tag}</a>)}
        </div>

        {
          origins.length > 0 && (
            <div class="origin">
              <p class="origin-title">リクエストから生まれた作品です</p>
              {origins.map((r) => (
                <p class="origin-item">
                  <span class="origin-id">{r.id}</span>
                  {r.public && r.text ? <span class="origin-text">{r.text}</span> : <span class="muted">（内容は非公開）</span>}
                </p>
              ))}
              <a href={url('/requests.html')}>リクエスト対応予定を見る →</a>
            </div>
          )
        }

        <div class="request-box">
          <h2>この子の別バージョンをリクエスト</h2>
          <p class="muted small">ボタンをえらんで、次の画面で自由に書き足せます。名前もメールもいりません。</p>
          <div class="variants">
            {
              requestOptions.variants.map((variant) => (
                <a class="btn btn-outline btn-sm" href={requestUrl(variant.id)}>
                  {variant.label}
                </a>
              ))
            }
          </div>
          <a class="more-link" href={requestUrl()}>くわしく書いてリクエストする →</a>
        </div>

        {
          linkEntries.length > 0 && (
            <div class="sub-block">
              <h2>ほかの場所でも見る</h2>
              <div class="meta-row">
                {linkEntries.map(([name, href]) => (
                  <a class="btn btn-ghost btn-sm" href={href} target="_blank" rel="noopener">
                    {linkLabels[name] ?? name}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <div class="sub-block">
          <h2>シェア</h2>
          <div class="meta-row">
            <a
              class="btn btn-ghost btn-sm"
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${work.title} - ${siteConfig.site_name}`)}&url=${encodeURIComponent(pageUrl)}`}
              target="_blank"
              rel="noopener">X でシェア</a
            >
            <button class="btn btn-ghost btn-sm" id="copy-url" type="button">URLコピー</button>
          </div>
        </div>
      </div>
    </div>

    {
      related.length > 0 && (
        <div class="related">
          <div class="section-head">
            <h2>似た雰囲気の作品</h2>
          </div>
          <div class="works-grid cols-6">
            {related.map((item) => (
              <WorkCard work={item} compact />
            ))}
          </div>
        </div>
      )
    }
  </section>
</Layout>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';
  import { initCounter } from '../../scripts/counter';

  initCounter();

  // PhotoSwipe（画像ズーム・キーボード操作 ←→/Esc 標準対応）
  const lightbox = new PhotoSwipeLightbox({
    gallery: '#pswp-gallery',
    children: 'a.main-image',
    pswpModule: () => import('photoswipe'),
  });
  lightbox.init();

  // 追加画像の切替
  const mainImages = [...document.querySelectorAll<HTMLElement>('.main-image')];
  const thumbBtns = [...document.querySelectorAll<HTMLElement>('.thumb-btn')];
  let currentIndex = 0;
  const show = (index: number) => {
    currentIndex = index;
    mainImages.forEach((el, i) => el.classList.toggle('active', i === index));
    thumbBtns.forEach((el, i) => el.classList.toggle('active', i === index));
  };
  thumbBtns.forEach((btn) =>
    btn.addEventListener('click', () => show(Number(btn.dataset.index ?? 0))),
  );

  // 左右矢印で画像切替 (クリック/タップ)
  const step = (dir: number) =>
    show((currentIndex + dir + mainImages.length) % mainImages.length);
  document.getElementById('img-prev')?.addEventListener('click', () => step(-1));
  document.getElementById('img-next')?.addEventListener('click', () => step(1));

  // URLコピー
  document.getElementById('copy-url')?.addEventListener('click', async (e) => {
    const button = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(location.href);
      button.textContent = '✓ コピーしました';
    } catch {
      button.textContent = 'コピーできませんでした';
    }
  });
</script>

<style>
  .detail-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
    font-weight: 500;
    font-size: 0.92rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(280px, 2fr);
    gap: 1.8rem;
    align-items: start;
  }

  .info-column {
    position: sticky;
    top: 5rem;
  }

  @media (max-width: 800px) {
    .detail-grid {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .info-column {
      position: static;
    }
  }

  .media-column {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .main-media {
    width: 100%;
  }

  .main-image-wrap {
    position: relative;
  }

  .img-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 2.6rem;
    height: 2.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(15, 13, 20, 0.55);
    color: #fff;
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s;
    padding: 0 0 0.2rem;
  }

  .img-nav:hover {
    background: rgba(15, 13, 20, 0.8);
  }

  .img-nav-prev {
    left: 0.6rem;
  }

  .img-nav-next {
    right: 0.6rem;
  }

  .main-image {
    display: none;
  }

  .main-image.active {
    display: block;
    cursor: zoom-in;
  }

  .main-image :global(img) {
    width: 100%;
    height: auto;
  }

  .thumb-strip {
    display: flex;
    gap: 0.5rem;
    padding: 0.7rem;
    overflow-x: auto;
    background: var(--bg-accent);
  }

  .thumb-btn {
    flex-shrink: 0;
    width: 68px;
    height: 68px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    background: none;
    opacity: 0.65;
    transition: opacity 0.15s, border-color 0.15s;
  }

  .thumb-btn:hover,
  .thumb-btn.active {
    opacity: 1;
  }

  .thumb-btn.active {
    border-color: var(--primary);
  }

  .thumb-btn :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info-column h1 {
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    margin-bottom: 0.5rem;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.8rem;
  }

  .meta-row time {
    font-size: 0.9rem;
    margin-right: 0.2rem;
  }

  .stats-row {
    gap: 0.8rem;
  }

  .stat {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .like-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--bg-card);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .like-btn:hover:not(:disabled) {
    border-color: var(--primary);
    color: var(--primary);
  }

  .like-btn.liked {
    background: var(--gradient);
    border-color: transparent;
    color: var(--ink-on-primary);
    opacity: 1;
  }

  .like-btn:disabled:not(.liked) {
    opacity: 0.5;
    cursor: wait;
  }

  .like-btn.liked:disabled {
    cursor: default;
  }

  .description {
    margin: 0.4rem 0 1rem;
    font-size: 0.95rem;
  }

  .origin {
    border-left: 3px solid var(--primary);
    background: var(--bg-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 0.8rem 1rem;
    margin: 1.2rem 0;
    font-size: 0.9rem;
  }

  .origin-title {
    font-weight: 700;
    color: var(--primary-deep);
  }

  .origin-item {
    margin: 0.3rem 0;
  }

  .origin-id {
    font-weight: 700;
    margin-right: 0.5rem;
  }

  .origin-text {
    white-space: pre-line;
  }

  .request-box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem;
    margin: 1.3rem 0;
  }

  .request-box h2 {
    font-size: 1.02rem;
    color: var(--primary-deep);
  }

  .variants {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.7rem 0;
  }

  .more-link {
    font-size: 0.88rem;
  }

  .sub-block {
    margin-top: 1.2rem;
  }

  .sub-block h2 {
    font-size: 0.85rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    margin-bottom: 0.45rem;
  }

  .related {
    margin-top: 3rem;
  }
</style>
