---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import WorkCard from '../../components/WorkCard.astro';
import RandomWork from '../../components/RandomWork.astro';
import {
  works,
  siteConfig,
  requestOptions,
  isVideo,
  resolveWorkImage,
  resolveVideoUrl,
  getRequestsForWork,
  formatDate,
  tagUrl,
  url,
} from '../../lib/data';
import { relatedWorks } from '../../lib/related';

export function getStaticPaths() {
  return works.map((work, i) => ({
    params: { slug: work.slug },
    props: {
      work,
      prevWork: works[i + 1] ?? null, // worksは新しい順: 次に古い作品
      nextWork: works[i - 1] ?? null,
    },
  }));
}

const { work, prevWork, nextWork } = Astro.props;

const video = isVideo(work.image_path);
const mainImage = video ? undefined : resolveWorkImage(work.image_path);
const videoUrl = video ? resolveVideoUrl(work.image_path) : undefined;
const additionalImages = (work.additional_images ?? [])
  .map((p) => resolveWorkImage(p))
  .filter((img) => img !== undefined);
const allImages = mainImage ? [mainImage, ...additionalImages] : additionalImages;

/**
 * 画像の「組」。1組ずつ切り替えて見せる。
 * 1枚目（本体）は単独。追加画像は、作品の設定 (additional_images_per_row) が 2・3 のとき、その枚数ずつ横に並べる。
 */
const perRow = work.additional_images_per_row ?? 1;
const slides: { images: typeof allImages; row: boolean }[] = mainImage ? [{ images: [mainImage], row: false }] : [];
for (let i = 0; i < additionalImages.length; i += perRow) {
  slides.push({ images: additionalImages.slice(i, i + perRow), row: perRow > 1 });
}
/** 通し番号つきの組（番号は「何枚目」の表示用） */
let imageCount = 0;
const numberedSlides = slides.map((slide) => ({ row: slide.row, items: slide.images.map((img) => ({ img, index: imageCount++ })) }));
/** 下に並べる小さい画像（1枚ずつ）と、それが何組目にあるか */
const stripItems = numberedSlides.flatMap((slide, s) => slide.items.map(({ img, index }) => ({ img, index, slide: s })));
/**
 * 横に並べた組の幅の上限 = 画面の高さ × この値。
 * いちばん縦長の画像でも、切り抜かずに全体が画面の高さに収まるようにする。
 */
const rowFit = perRow * Math.min(1, ...additionalImages.map((img) => img.width / img.height));
/** 横に並べる画像の書き出し幅（表示は列幅の 1/2〜1/3。拡大表示は元の画像を使う） */
const ROW_IMAGE_WIDTH = 640;

/** 高さが幅の2倍を超える画像（抱き枕カバー風など）。横幅いっぱいに広げず、全体が画面に収まる高さで見せる */
const isTall = (img: { width: number; height: number }) => img.height > img.width * 2;
/** 切り替え用の小さい画像の高さ（表示の2倍の解像度）。切り抜かず、縦横比のまま並べる */
const STRIP_THUMB_HEIGHT = 192;

const links = work.external_links ?? {};
const linkEntries = Object.entries(links).filter(([, v]) => v);
const linkLabels: Record<string, string> = { twitter: 'X (Twitter)', pixiv: 'Pixiv', booth: 'BOOTH', fanbox: 'FANBOX' };

const related = relatedWorks(work, works, 6);
const origins = getRequestsForWork(work.slug);

const requestUrl = (variant?: string) =>
  `${url('/request.html')}?${new URLSearchParams({ from: 'work', slug: work.slug, ...(variant ? { variant } : {}) })}`;

// OGP: R-15 で X 非表示指定のものはプレースホルダー（旧サイト互換）
const hideOgThumb = work.sensitive && work.hide_sensitive_thumbnail_on_x;
const ogSource = hideOgThumb
  ? '/static/img/works/placeholder.svg'
  : (work.x_thumbnail ?? work.thumbnail);
const ogImg = resolveWorkImage(ogSource);
const ogImage = ogImg ? new URL(ogImg.src, Astro.site).href : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout title={work.title} description={work.description || undefined} ogImage={ogImage} activeNav="gallery">
  <section class="section container detail">
    <nav class="detail-nav" aria-label="ほかの作品へ">
      {
        prevWork ? (
          <a class="nav-prev" href={url(`/works/${prevWork.slug}.html`)} rel="prev">← 前の作品</a>
        ) : (
          <span class="nav-prev muted">← 前の作品</span>
        )
      }
      <span class="nav-center">
        <a href={url('/gallery.html')}>Gallery</a>
        <RandomWork class="random-link">🎲 おまかせで1枚</RandomWork>
      </span>
      {
        nextWork ? (
          <a class="nav-next" href={url(`/works/${nextWork.slug}.html`)} rel="next">次の作品 →</a>
        ) : (
          <span class="nav-next muted">次の作品 →</span>
        )
      }
    </nav>

    <div class="detail-grid">
      <div class="media-column">
        {
          video ? (
            <video src={videoUrl} controls loop playsinline class="main-media"></video>
          ) : (
            allImages.length > 0 && (
              <>
                <div
                  class="main-image-wrap"
                  id="pswp-gallery"
                  style={perRow > 1 ? `--per-row: ${perRow}; --row-fit: ${rowFit.toFixed(4)}` : undefined}
                >
                  {numberedSlides.map((slide, s) => (
                    <div class:list={['slide', { active: s === 0, row: slide.row }]}>
                      {slide.items.map(({ img, index }) => (
                        <a
                          href={img.src}
                          data-pswp-width={img.width}
                          data-pswp-height={img.height}
                          class:list={['main-image', { tall: isTall(img) }]}
                        >
                          <Image
                            src={img}
                            alt={allImages.length > 1 ? `${work.title} (${index + 1}/${allImages.length})` : work.title}
                            width={slide.row ? Math.min(img.width, ROW_IMAGE_WIDTH) : 900}
                            format="webp"
                            loading={s === 0 ? 'eager' : 'lazy'}
                          />
                        </a>
                      ))}
                    </div>
                  ))}
                  {slides.length > 1 && (
                    <>
                      <button class="img-nav img-nav-prev" id="img-prev" aria-label="前の画像" type="button">‹</button>
                      <button class="img-nav img-nav-next" id="img-next" aria-label="次の画像" type="button">›</button>
                    </>
                  )}
                </div>
                {allImages.length > 1 && (
                  <div class="thumb-strip" id="thumb-strip">
                    {stripItems.map(({ img, index, slide }) => (
                      <button
                        class:list={['thumb-btn', { active: slide === 0 }]}
                        data-slide={slide}
                        type="button"
                        aria-label={`${index + 1}枚目を表示`}
                      >
                        <Image
                          src={img}
                          alt=""
                          width={Math.round((STRIP_THUMB_HEIGHT * img.width) / img.height)}
                          height={STRIP_THUMB_HEIGHT}
                          format="webp"
                        />
                      </button>
                    ))}
                  </div>
                )}
              </>
            )
          )
        }
      </div>

      <div class="info-column">
        <h1>{work.title}</h1>
        <div class="meta-row">
          <time datetime={work.date} class="muted">{formatDate(work.date)}</time>
          <span class="tag">{work.category}</span>
          {work.sensitive && <span class="r15-mark">R-15</span>}
        </div>
        <div class="meta-row stats-row">
          <span class="stat" title="閲覧数">👁 <span id="view-count">–</span></span>
          <button class="like-btn" id="like-btn" data-work-id={work.id} title="いいね" type="button">
            ♥ <span id="like-count">–</span>
          </button>
        </div>

        {work.description && <p class="description">{work.description}</p>}

        <div class="meta-row">
          {work.tags.map((tag) => <a class="tag" href={tagUrl(tag)}>{tag}</a>)}
        </div>

        {
          origins.length > 0 && (
            <div class="origin">
              <p class="origin-title">リクエストから生まれた作品です</p>
              {origins.map((r) => (
                <p class="origin-item">
                  <span class="origin-id">{r.id}</span>
                  {r.public && r.text ? <span class="origin-text">{r.text}</span> : <span class="muted">（内容は非公開）</span>}
                </p>
              ))}
              <a href={url('/requests.html')}>リクエスト対応予定を見る →</a>
            </div>
          )
        }

        <div class="request-box">
          <h2>この子の別バージョンをリクエスト</h2>
          <p class="muted small">ボタンをえらんで、次の画面で自由に書き足せます。名前もメールもいりません。</p>
          <div class="variants">
            {
              requestOptions.variants.map((variant) => (
                <a class="btn btn-outline btn-sm" href={requestUrl(variant.id)}>
                  {variant.label}
                </a>
              ))
            }
          </div>
          <a class="more-link" href={requestUrl()}>くわしく書いてリクエストする →</a>
        </div>

        {
          linkEntries.length > 0 && (
            <div class="sub-block">
              <h2>ほかの場所でも見る</h2>
              <div class="meta-row">
                {linkEntries.map(([name, href]) => (
                  <a class="btn btn-ghost btn-sm" href={href} target="_blank" rel="noopener">
                    {linkLabels[name] ?? name}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <div class="sub-block">
          <h2>シェア</h2>
          <div class="meta-row">
            <a
              class="btn btn-ghost btn-sm"
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${work.title} - ${siteConfig.site_name}`)}&url=${encodeURIComponent(pageUrl)}`}
              target="_blank"
              rel="noopener">X でシェア</a
            >
            <button class="btn btn-ghost btn-sm" id="copy-url" type="button">URLコピー</button>
          </div>
        </div>
      </div>
    </div>

    {
      related.length > 0 && (
        <div class="related">
          <div class="section-head">
            <h2>似た雰囲気の作品</h2>
          </div>
          <div class="works-grid cols-6">
            {related.map((item) => (
              <WorkCard work={item} compact />
            ))}
          </div>
        </div>
      )
    }

    <p class="text-center more-random">
      <RandomWork class="btn btn-ghost" list={false}>🎲 おまかせで1枚</RandomWork>
    </p>
  </section>
</Layout>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';
  import { initCounter } from '../../scripts/counter';

  initCounter();

  // PhotoSwipe（画像ズーム・キーボード操作 ←→/Esc 標準対応）
  const lightbox = new PhotoSwipeLightbox({
    gallery: '#pswp-gallery',
    children: 'a.main-image',
    pswpModule: () => import('photoswipe'),
  });
  lightbox.init();

  // 画像の切替。1組（1枚、または横に並べた2〜3枚）ずつ見せる
  const slides = [...document.querySelectorAll<HTMLElement>('.slide')];
  const thumbBtns = [...document.querySelectorAll<HTMLElement>('.thumb-btn')];
  // 次の組の画像を先に読み込んでおく（切り替えた直後に、並んだ画像が空白で見えないように）
  const preload = (index: number) =>
    slides[index % slides.length]?.querySelectorAll('img').forEach((img) => {
      img.loading = 'eager';
    });
  let currentSlide = 0;
  const show = (index: number) => {
    currentSlide = index;
    slides.forEach((el, i) => el.classList.toggle('active', i === index));
    // 下の小さい画像は、いま出ている組のものをすべて選択中にする
    thumbBtns.forEach((el) => el.classList.toggle('active', Number(el.dataset.slide) === index));
    preload(index + 1);
  };
  if (slides.length > 1) window.addEventListener('load', () => preload(1));
  thumbBtns.forEach((btn) =>
    btn.addEventListener('click', () => show(Number(btn.dataset.slide ?? 0))),
  );

  // 左右矢印で切替 (クリック/タップ)
  const step = (dir: number) =>
    show((currentSlide + dir + slides.length) % slides.length);
  document.getElementById('img-prev')?.addEventListener('click', () => step(-1));
  document.getElementById('img-next')?.addEventListener('click', () => step(1));

  // URLコピー
  document.getElementById('copy-url')?.addEventListener('click', async (e) => {
    const button = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(location.href);
      button.textContent = '✓ コピーしました';
    } catch {
      button.textContent = 'コピーできませんでした';
    }
  });
</script>

<style>
  .detail-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'prev center next';
    align-items: center;
    gap: 0.5rem 1rem;
    margin-bottom: 1.2rem;
    font-weight: 500;
    font-size: 0.92rem;
  }

  .nav-prev {
    grid-area: prev;
    justify-self: start;
  }

  .nav-next {
    grid-area: next;
    justify-self: end;
  }

  .nav-center {
    grid-area: center;
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  /* せまい画面では「Gallery・おまかせ」を2段目に回す */
  @media (max-width: 560px) {
    .detail-nav {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'prev next'
        'center center';
    }

    .nav-center {
      justify-content: center;
    }
  }

  .more-random {
    margin-top: 2.5rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(280px, 2fr);
    gap: 1.8rem;
    align-items: start;
  }

  .info-column {
    position: sticky;
    top: 5rem;
  }

  @media (max-width: 800px) {
    .detail-grid {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .info-column {
      position: static;
    }
  }

  .media-column {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .main-media {
    width: 100%;
  }

  .main-image-wrap {
    position: relative;
  }

  .img-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 2.6rem;
    height: 2.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(15, 13, 20, 0.55);
    color: #fff;
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s;
    padding: 0 0 0.2rem;
  }

  .img-nav:hover {
    background: rgba(15, 13, 20, 0.8);
  }

  .img-nav-prev {
    left: 0.6rem;
  }

  .img-nav-next {
    right: 0.6rem;
  }

  .slide {
    display: none;
  }

  .slide.active {
    display: block;
  }

  .main-image {
    display: block;
    cursor: zoom-in;
  }

  .main-image :global(img) {
    width: 100%;
    height: auto;
  }

  /* とても縦長の画像は切り抜かず、全体が画面に収まる大きさにする（クリックで拡大） */
  .main-image.tall :global(img) {
    width: auto;
    max-height: max(calc(100vh - 6rem), 30rem);
    max-height: max(calc(100dvh - 6rem), 30rem);
    margin: 0 auto;
  }

  /*
   * 追加画像を2〜3枚ずつ横に並べる組（管理ツールの「追加画像の並べ方」）。
   * 1枚の幅は列の 1/2・1/3。枚数が足りない最後の組も、同じ大きさのまま中央に寄せる。
   * 幅の上限 (--row-fit) で、いちばん縦長の画像でも全体が画面の高さに収まるようにする。
   */
  .slide.row.active {
    --row-gap: 4px;
    --row-gaps: calc(var(--row-gap) * (var(--per-row) - 1));
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: var(--row-gap);
    max-width: calc(max(100vh - 6rem, 30rem) * var(--row-fit) + var(--row-gaps));
    max-width: calc(max(100dvh - 6rem, 30rem) * var(--row-fit) + var(--row-gaps));
    margin: 0 auto;
  }

  .slide.row .main-image {
    flex: 0 0 calc((100% - var(--row-gaps)) / var(--per-row));
    min-width: 0;
  }

  .slide.row .main-image :global(img) {
    width: 100%;
    max-height: none;
    margin: 0;
  }

  .thumb-strip {
    display: flex;
    gap: 0.5rem;
    padding: 0.7rem;
    overflow-x: auto;
    background: var(--bg-accent);
  }

  /* 幅は画像の縦横比に合わせる（正方形に切り抜かない） */
  .thumb-btn {
    flex-shrink: 0;
    height: 96px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    background: none;
    opacity: 0.65;
    transition: opacity 0.15s, border-color 0.15s;
  }

  .thumb-btn:hover,
  .thumb-btn.active {
    opacity: 1;
  }

  .thumb-btn.active {
    border-color: var(--primary);
  }

  .thumb-btn :global(img) {
    width: auto;
    max-width: none;
    height: 100%;
  }

  .info-column h1 {
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    margin-bottom: 0.5rem;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.8rem;
  }

  .meta-row time {
    font-size: 0.9rem;
    margin-right: 0.2rem;
  }

  .stats-row {
    gap: 0.8rem;
  }

  .stat {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .like-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--bg-card);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .like-btn:hover:not(:disabled) {
    border-color: var(--primary);
    color: var(--primary);
  }

  .like-btn.liked {
    background: var(--gradient);
    border-color: transparent;
    color: var(--ink-on-primary);
    opacity: 1;
  }

  .like-btn:disabled:not(.liked) {
    opacity: 0.5;
    cursor: wait;
  }

  .like-btn.liked:disabled {
    cursor: default;
  }

  .description {
    margin: 0.4rem 0 1rem;
    font-size: 0.95rem;
  }

  .origin {
    border-left: 3px solid var(--primary);
    background: var(--bg-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 0.8rem 1rem;
    margin: 1.2rem 0;
    font-size: 0.9rem;
  }

  .origin-title {
    font-weight: 700;
    color: var(--primary-deep);
  }

  .origin-item {
    margin: 0.3rem 0;
  }

  .origin-id {
    font-weight: 700;
    margin-right: 0.5rem;
  }

  .origin-text {
    white-space: pre-line;
  }

  .request-box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem;
    margin: 1.3rem 0;
  }

  .request-box h2 {
    font-size: 1.02rem;
    color: var(--primary-deep);
  }

  .variants {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.7rem 0;
  }

  .more-link {
    font-size: 0.88rem;
  }

  .sub-block {
    margin-top: 1.2rem;
  }

  .sub-block h2 {
    font-size: 0.85rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    margin-bottom: 0.45rem;
  }

  .related {
    margin-top: 3rem;
  }
</style>
