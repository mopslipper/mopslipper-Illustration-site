---
import { siteConfig, url, defaultOgImage } from '../lib/data';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  activeNav?: string;
}

const {
  title,
  description = siteConfig.site_description,
  ogImage,
  activeNav = '',
} = Astro.props;

const pageTitle = title ? `${title} - ${siteConfig.site_title}` : siteConfig.site_title;

// og:image: ページ指定が無ければ共通OGP画像 (static/img/ogp.*) にフォールバック
const resolvedOgImage = ogImage ?? (defaultOgImage ? new URL(defaultOgImage.src, Astro.site).href : undefined);
const isDefaultOg = !ogImage && !!defaultOgImage;

const navItems = [
  { label: 'Home', href: url('/'), key: 'home' },
  { label: 'Gallery', href: url('/gallery.html'), key: 'gallery' },
  { label: 'Commission', href: url('/commission.html'), key: 'commission' },
  { label: 'About', href: url('/about.html'), key: 'about' },
  // 広い画面ではヘッダー右端（「リクエストする」の右）に出すので、メニュー内は狭い画面だけ
  { label: 'リクエスト対応予定', href: url('/requests.html'), key: 'requests', mobileOnly: true },
];

const footerLinks = [
  { label: 'リクエストする', href: url('/request.html') },
  { label: 'Contact', href: url('/contact.html') },
  { label: 'Cliant Share', href: url('/cliantshare.html') },
  { label: 'Privacy Policy', href: url('/privacy.html') },
  { label: 'RSS', href: url('/rss.xml') },
];

const social = siteConfig.social_links;
const rssUrl = url('/rss.xml');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={siteConfig.meta_keywords} />
    <meta name="author" content={siteConfig.author.name} />
    <meta name="theme-color" content="#0f0d14" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.site_title} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {isDefaultOg && defaultOgImage && <meta property="og:image:width" content={String(defaultOgImage.width)} />}
    {isDefaultOg && defaultOgImage && <meta property="og:image:height" content={String(defaultOgImage.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.site_title} href={rssUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Maru+Gothic:wght@500;700&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="inner">
        <a class="brand" href={url('/')}>{siteConfig.site_name}</a>
        <nav class="site-nav" id="site-nav" aria-label="メインメニュー">
          <ul>
            {
              navItems.map((item) => (
                <li class={item.mobileOnly ? 'nav-mobile-only' : undefined}>
                  <a
                    href={item.href}
                    class={item.key === activeNav ? 'active' : ''}
                    aria-current={item.key === activeNav ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="btn btn-primary btn-sm header-cta" href={url('/request.html')}>リクエストする</a>
        <a
          class:list={['btn', 'btn-outline', 'btn-sm', 'header-board', { active: activeNav === 'requests' }]}
          href={url('/requests.html')}
          aria-current={activeNav === 'requests' ? 'page' : undefined}
        >
          リクエスト対応予定
        </a>
        <button class="nav-toggle" id="nav-toggle" aria-label="メニュー" aria-expanded="false" aria-controls="site-nav">
          ☰
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <div>
          <p class="footer-brand">{siteConfig.site_name}</p>
          <p>{siteConfig.footer_text}</p>
          <p class="row" style="margin-top:0.5rem;">
            {social.twitter && <a href={social.twitter} target="_blank" rel="noopener">X (Twitter)</a>}
            {social.pixiv && <a href={social.pixiv} target="_blank" rel="noopener">Pixiv</a>}
          </p>
        </div>
        <ul class="footer-links">
          {footerLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
        <p class="copyright">
          &copy; {siteConfig.copyright_year} {siteConfig.author.name}. All Rights Reserved.
        </p>
      </div>
    </footer>

    {
      siteConfig.nsfw_warning && (
        <div class="modal-backdrop" id="age-gate" hidden>
          <div class="modal" role="dialog" aria-modal="true" aria-labelledby="age-gate-title">
            <h2 id="age-gate-title">年齢確認</h2>
            <p>{siteConfig.nsfw_text}</p>
            <p>あなたは15歳以上ですか？</p>
            <p class="muted small">※ どちらを選んでもサイトの閲覧は可能です</p>
            <div class="actions">
              <button class="btn btn-primary" id="age-yes" type="button">
                はい（15歳以上）
              </button>
              <button class="btn btn-outline" id="age-no" type="button">
                いいえ（15歳未満）
              </button>
            </div>
          </div>
        </div>
      )
    }

    <script>
      // モバイルナビ
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
      });

      // 年齢確認（初回のみ）。R-15 の作品があることを知らせる案内で、
      // 回答は記録するだけ。どちらを選んでも表示内容は変えない。
      const gate = document.getElementById('age-gate');
      const KEY = 'mopslipper_age_confirmed_v1';
      const read = () => {
        try {
          return localStorage.getItem(KEY);
        } catch {
          return 'unavailable'; // 保存できない環境では毎回出さない
        }
      };
      if (gate && !read()) {
        gate.hidden = false;
        document.getElementById('age-yes')?.focus();
      }
      const close = (answer: 'adult' | 'minor') => {
        try {
          localStorage.setItem(KEY, answer);
        } catch {
          /* 保存できなくても閲覧は続けられる */
        }
        if (gate) gate.hidden = true;
      };
      document.getElementById('age-yes')?.addEventListener('click', () => close('adult'));
      document.getElementById('age-no')?.addEventListener('click', () => close('minor'));
    </script>
  </body>
</html>
