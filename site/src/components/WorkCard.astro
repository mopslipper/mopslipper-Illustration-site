---
import { Image } from 'astro:assets';
import { isVideo, resolveWorkThumb, getCounts, url, tagUrl, THUMB_SIZE, type Work } from '../lib/data';
import { GENERIC_TAGS } from '../lib/related';

interface Props {
  work: Work;
  /** 画像とタイトルだけの小さなカード（似た作品など） */
  compact?: boolean;
}

const { work, compact = false } = Astro.props;

const video = isVideo(work.image_path);
const thumb = resolveWorkThumb(work);
const detailUrl = url(`/works/${work.slug}.html`);
const stats = getCounts(work.id);
const cardTags = work.tags.filter((tag) => !GENERIC_TAGS.includes(tag)).slice(0, 3);
---

<article
  class:list={['work-card', { compact }]}
  data-slug={work.slug}
  data-title={work.title}
  data-sensitive={String(work.sensitive ?? false)}
  data-category={work.category}
  data-tags={work.tags.join(',')}
  data-description={work.description}
>
  <a class="thumb" href={detailUrl} tabindex="-1" aria-hidden="true">
    {
      thumb ? (
        <Image src={thumb} alt="" width={THUMB_SIZE} height={THUMB_SIZE} format="webp" loading="lazy" />
      ) : (
        <span class="thumb-missing">No image</span>
      )
    }
    {work.sensitive && <span class="r15-mark">R-15</span>}
    {video && <span class="video-indicator">▶</span>}
  </a>
  <div class="info">
    <a href={detailUrl} class="title">{work.title}</a>
    {
      !compact && (
        <>
          <div class="meta">
            {cardTags.map((tag) => (
              <a class="tag" href={tagUrl(tag)} data-tag-link={tag}>
                {tag}
              </a>
            ))}
          </div>
          <div class="card-stats">
            <span title="閲覧数">👁 {stats.views.toLocaleString('ja-JP')}</span>
            <span title="いいね">♥ {stats.likes.toLocaleString('ja-JP')}</span>
          </div>
        </>
      )
    }
  </div>
</article>

<style>
  .thumb-missing {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
